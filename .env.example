# Teaching Poster - Image Generation API Keys
# Copy this file to .env and fill in your API keys.
# Only the provider you plan to use needs to be configured.

# OpenAI (DALL-E 3)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Stability AI (Stable Diffusion 3)
# Get your key at: https://platform.stability.ai/account/keys
STABILITY_API_KEY=sk-your-stability-key-here

# Silicon Flow (Flux) - Chinese-friendly provider
# Get your key at: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-your-siliconflow-key-here
